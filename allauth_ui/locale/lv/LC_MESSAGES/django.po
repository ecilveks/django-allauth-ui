#. range generated by paginators, e.g. [1, 2, '…', 5, 6, 7, '…', 9, 10].
#: venv/lib/python3.14/site-packages/django/core/paginator.py:33
msgid "…"
msgstr "…"

#: venv/lib/python3.14/site-packages/django/core/paginator.py:35
msgid "That page number is not an integer"
msgstr "Lapas numurs nav vesels skaitlis"

#: venv/lib/python3.14/site-packages/django/core/paginator.py:36
msgid "That page number is less than 1"
msgstr "Lapas numurs ir mazāks par 1"

#: venv/lib/python3.14/site-packages/django/core/paginator.py:37
msgid "That page contains no results"
msgstr "Šajā lapā nav rezultātu"

#: venv/lib/python3.14/site-packages/django/core/validators.py:22
msgid "Enter a valid value."
msgstr "Ievadiet derīgu vērtību."

#: venv/lib/python3.14/site-packages/django/core/validators.py:70
msgid "Enter a valid domain name."
msgstr "Ievadiet derīgu domēna vārdu."

#: venv/lib/python3.14/site-packages/django/core/validators.py:153
#: venv/lib/python3.14/site-packages/django/forms/fields.py:773
msgid "Enter a valid URL."
msgstr "Ievadiet derīgu URL."

#: venv/lib/python3.14/site-packages/django/core/validators.py:200
