#: allauth_ui/templates/account/account_inactive.html:5
msgid "Account Inactive"
msgstr "Konti ir neaktīvs"

#: allauth_ui/templates/account/account_inactive.html:6
msgid "This account is inactive."
msgstr "Šis konts ir neaktīvs."

#: allauth_ui/templates/account/base_reauthenticate.html:5
msgid "Confirm Access"
msgstr "Apstiprināt piekļuvi"

#: allauth_ui/templates/account/base_reauthenticate.html:6
msgid ""
"\n"
"    Please reauthenticate to safeguard your account.\n"
"    "
msgstr ""
"\n"
"    Lūdzu, veiciet atkārtotu autentifikāciju, lai aizsargātu savu kontu.\n"
"    "

#: allauth_ui/templates/account/base_reauthenticate.html:13
#: allauth_ui/templates/mfa/authenticate.html:17
msgid "Alternative options"
msgstr "Alternatīvas opcijas"

#: allauth_ui/templates/account/confirm_login_code.html:8
#: allauth_ui/templates/account/login.html:6
#: allauth_ui/templates/allauth/layouts/base.html:55
#: allauth_ui/templates/mfa/authenticate.html:11
msgid "Sign In"
msgstr "Pieslēgties"

#: allauth_ui/templates/account/confirm_login_code.html:10
msgid "Enter Sign-In Code"
msgstr "Ievadiet pieslēgšanās kodu"

#: allauth_ui/templates/account/confirm_login_code.html:15
#, python-format
msgid ""
"We’ve sent a code to %(email_link)s. The code expires shortly, so please "
"enter it soon."
msgstr ""
"Mēs nosūtījām kodu uz %(email_link)s. Koda derīguma termiņš drīz beigsies, tādēļ, lūdzu, ievadiet to pēc iespējas ātrāk."

#: allauth_ui/templates/account/confirm_login_code.html:22
#: allauth_ui/templates/mfa/authenticate.html:22
msgid "Cancel"
msgstr "Atcelt"

#: allauth_ui/templates/account/email.html:5
msgid "Email Addresses"
msgstr "E-pasta adreses"

#: allauth_ui/templates/account/email.html:9
msgid "The following email addresses are associated with your account:"
msgstr "Ar jūsu kontu ir saistītas šādas e-pasta adreses:"

#: allauth_ui/templates/account/email.html:22
msgid "verified"
msgstr "apstiprināta"

#: allauth_ui/templates/account/email.html:25
msgid "primary"
msgstr "galvenā"

#: allauth_ui/templates/account/email.html:41
msgid "Make Primary"
msgstr "Padarīt par galveno"

#: allauth_ui/templates/account/email.html:44
msgid "Re-send verification"
msgstr "Nosūtīt apstiprinājumu atkārtoti"

#: allauth_ui/templates/account/email.html:47
#: allauth_ui/templates/socialaccount/connections.html:35
msgid "Remove"
msgstr "Noņemt"

#: allauth_ui/templates/account/email.html:56
msgid "Add Email Address"
msgstr "Pievienot e-pasta adresi"

#: allauth_ui/templates/account/email.html:57
msgid "Add Email"
msgstr "Pievienot e-pastu"

#: allauth_ui/templates/account/email_confirm.html:7
#: allauth_ui/templates/account/verification_sent.html:5
msgid "Confirm Email Address"
msgstr "Apstiprināt e-pasta adresi"

#: allauth_ui/templates/account/email_confirm.html:13
#, python-format
msgid ""
"Please confirm that <a href=\"mailto:%(email)s\">%(email)s</a> is an email "
"address for user %(user_display)s."
msgstr ""
"Lūdzu, apstipriniet, ka <a href=\"mailto:%(email)s\">%(email)s</a> ir lietotāja %(user_display)s e-pasta adrese."

#: allauth_ui/templates/account/email_confirm.html:16
#: allauth_ui/templates/account/reauthenticate.html:9
#: allauth_ui/templates/mfa/reauthenticate.html:9
msgid "Confirm"
msgstr "Apstiprināt"

#: allauth_ui/templates/account/email_confirm.html:23
#, python-format
msgid ""
"Unable to confirm %(email)s because it is already confirmed by a different "
"account."
msgstr ""
"Neizdevās apstiprināt e-pastu %(email)s, jo tas jau ir apstiprināts citā kontā."

#: allauth_ui/templates/account/email_confirm.html:29
#, python-format
msgid ""
"This email confirmation link expired or is invalid. Please <a "
"href=\"%(email_url)s\">issue a new email confirmation request</a>."
msgstr ""
"Šī e-pasta apstiprināšanas saite ir novecojusi vai nederīga. Lūdzu, <a href=\"%(email_url)s\">pieprasiet jaunu e-pasta apstiprinājumu</a>."

#: allauth_ui/templates/account/login.html:10
#, python-format
msgid ""
"If you have not created an account yet, then please\n"
"            <a class=\"link\" href=\"%(signup_url)s\">sign up</a> first."
msgstr ""
"Ja vēl neesat izveidojis kontu, lūdzu, vispirms\n"
"            <a class=\"link\" href=\"%(signup_url)s\">reģistrējieties</a>."

#: allauth_ui/templates/account/login.html:19
msgid "Remember me"
msgstr "Atcerēties mani"

#: allauth_ui/templates/account/login.html:27
msgid "Forgot password?"
msgstr "Aizmirsi paroli?"

#: allauth_ui/templates/account/login.html:33
#: allauth_ui/templates/account/request_login_code.html:6
msgid "Mail me a sign-in code"
msgstr "Nosūtīt man pieslēgšanās kodu uz e-pastu"

#: allauth_ui/templates/account/logout.html:5
#: allauth_ui/templates/allauth/layouts/base.html:50
#: allauth_ui/templates/usersessions/usersession_list.html:15
msgid "Sign Out"
msgstr "Izrakstīties"

#: allauth_ui/templates/account/logout.html:6
msgid "Are you sure you want to sign out?"
msgstr "Vai tiešām vēlaties izrakstīties?"

#: allauth_ui/templates/account/logout.html:9
#: allauth_ui/templates/socialaccount/login.html:14
#: allauth_ui/templates/socialaccount/signup.html:12
msgid "Continue"
msgstr "Turpināt"

#: allauth_ui/templates/account/password_change.html:6
#: allauth_ui/templates/account/password_reset_from_key.html:8
#: allauth_ui/templates/account/password_reset_from_key.html:18
#: allauth_ui/templates/account/password_reset_from_key_done.html:5
#: allauth_ui/templates/allauth/layouts/base.html:38
msgid "Change Password"
msgstr "Mainīt paroli"

#: allauth_ui/templates/account/password_change.html:14
msgid "Forgot Password?"
msgstr "Aizmirsi paroli?"

#: allauth_ui/templates/account/password_reset.html:5
#: allauth_ui/templates/account/password_reset_done.html:5
msgid "Password Reset"
msgstr "Paroles atiestatīšana"

#: allauth_ui/templates/account/password_reset.html:11
msgid ""
"Forgotten your password? Enter your email address below, and we'll send you "
"an email allowing you to reset it."
msgstr ""
"Esat aizmirsis savu paroli? Ievadiet savu e-pasta adresi zemāk, un mēs nosūtīsim jums e-pastu ar saiti tās atiestatīšanai."

#: allauth_ui/templates/account/password_reset.html:14
msgid "Reset My Password"
msgstr "Atiestatīt manu paroli"

#: allauth_ui/templates/account/password_reset.html:20
msgid "Please contact us if you have any trouble resetting your password."
msgstr "Lūdzu, sazinieties ar mums, ja rodas problēmas ar paroles atiestatīšanu."

#: allauth_ui/templates/account/password_reset_done.html:11
msgid ""
"We have sent you an email. If you have not received it please check your "
"spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr ""
"Mēs nosūtījām jums e-pastu. Ja neesat to saņēmis, lūdzu, pārbaudiet mēstuļu (spam) mapi. Pretējā gadījumā sazinieties ar mums, ja nesaņemat to dažu minūšu laikā."

#: allauth_ui/templates/account/password_reset_from_key.html:6
msgid "Bad Token"
msgstr "Nederīga marķieris (Token)"

#: allauth_ui/templates/account/password_reset_from_key.html:14
#, python-format
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used.  Please request a <a href=\"%(passwd_reset_url)s\">new password reset</"
"a>."
msgstr ""
"Paroles atiestatīšanas saite bija nederīga, iespējams, tāpēc, ka tā jau ir izmantota. Lūdzu, pieprasiet <a href=\"%(passwd_reset_url)s\">jaunu paroles atiestatīšanu</a>."

#: allauth_ui/templates/account/password_reset_from_key_done.html:6
msgid "Your password is now changed."
msgstr "Jūsu parole ir veiksmīgi nomainīta."

#: allauth_ui/templates/account/password_set.html:6
msgid "Set Password"
msgstr "Iestatīt paroli"

#: allauth_ui/templates/account/reauthenticate.html:6
msgid "Enter your password:"
msgstr "Ievadiet savu paroli:"

#: allauth_ui/templates/account/request_login_code.html:9
msgid ""
"You will receive an email containing a special code for a password-free sign-"
"in."
msgstr ""
"Jūs saņemsiet e-pastu ar īpašu kodu, lai pieslēgtos bez paroles."

#: allauth_ui/templates/account/signup.html:6
#: allauth_ui/templates/allauth/layouts/base.html:59
#: allauth_ui/templates/socialaccount/signup.html:6
#: allauth_ui/templates/socialaccount/signup.html:14
msgid "Sign Up"
msgstr "Reģistrēties"

#: allauth_ui/templates/account/signup.html:7
#, python-format
msgid ""
"Already have an account? Then please <a href=\"%(login_url)s\" "
"class=\"link\">sign in</a>."
msgstr ""
"Jums jau ir konts? Tādā gadījumā, lūdzu, <a href=\"%(login_url)s\" class=\"link\">pieslēdzieties</a>."

#: allauth_ui/templates/account/signup_closed.html:5
msgid "Sign Up Closed"
msgstr "Reģistrācija ir slēgta"

#: allauth_ui/templates/account/signup_closed.html:6
msgid "We are sorry, but the sign up is currently closed."
msgstr "Diemžēl reģistrācija šobrīd ir slēgta."

#: allauth_ui/templates/account/verification_sent.html:6
msgid ""
"We have sent an email to you for verification. Follow the link provided to "
"finalize the signup process. If you do not see the verification email in "
"your main inbox, check your spam folder. Please contact us if you do not "
"receive the verification email within a few minutes."
msgstr ""
"Mēs nosūtījām jums apstiprinājuma e-pastu. Sekojiet tajā norādītajai saitei, lai pabeigtu reģistrācijas procesu. Ja neredzat e-pastu savā iesūtnē, pārbaudiet mēstuļu mapi. Ja nesaņemat e-pastu dažu minūšu laikā, lūdzu, sazinieties ar mums."

#: allauth_ui/templates/allauth/layouts/base.html:34
msgid "Change Email"
msgstr "Mainīt e-pastu"

#: allauth_ui/templates/allauth/layouts/base.html:42
#: allauth_ui/templates/mfa/authenticate.html:6
#: allauth_ui/templates/mfa/index.html:5
msgid "Two-Factor Authentication"
msgstr "Divfaktoru autentifikācija"

#: allauth_ui/templates/allauth/layouts/base.html:46
#: allauth_ui/templates/usersessions/usersession_list.html:6
msgid "Sessions"
msgstr "Sesijas"

#: allauth_ui/templates/mfa/authenticate.html:7
msgid ""
"Your account is protected by two-factor authentication. Please enter an "
"authenticator code:"
msgstr ""
"Jūsu konts ir aizsargāts ar divfaktoru autentifikāciju. Lūdzu, ievadiet autentifikatora kodu:"

#: allauth_ui/templates/mfa/authenticate.html:10
#: allauth_ui/templates/mfa/index.html:22
#: allauth_ui/templates/mfa/totp/activate_form.html:10
msgid "Activate"
msgstr "Aktivizēt"

#: allauth_ui/templates/mfa/authenticate.html:20
msgid "Use a security key"
msgstr "Izmantot drošības atslēgu"

#: allauth_ui/templates/mfa/index.html:8
msgid "Authenticator App"
msgstr "Autentifikatora lietotne"

#: allauth_ui/templates/mfa/index.html:11
msgid "Authentication using an authenticator app is active."
msgstr "Autentifikācija, izmantojot lietotni, ir aktīva."

#: allauth_ui/templates/mfa/index.html:15
#: allauth_ui/templates/mfa/totp/deactivate_form.html:11
msgid "Deactivate"
msgstr "Deaktivizēt"

#: allauth_ui/templates/mfa/index.html:19
msgid "An authenticator app is not active."
msgstr "Autentifikatora lietotne nav aktīva."

#: allauth_ui/templates/mfa/index.html:27
msgid "Security Keys"
msgstr "Drošības atslēgas"

#: allauth_ui/templates/mfa/index.html:30
#, python-format
msgid "You have added %(count)s security key."
msgid_plural "You have added %(count)s security keys."
msgstr[0] "Jūs esat pievienojis %(count)s drošības atslēgu."
msgstr[1] "Jūs esat pievienojis %(count)s drošības atslēgas."
msgstr[2] "Jūs esat pievienojis %(count)s drošības atslēgu."

#: allauth_ui/templates/mfa/index.html:34
msgid "Manage"
msgstr "Pārvaldīt"

#: allauth_ui/templates/mfa/index.html:36
msgid "No security keys have been added."
msgstr "Nav pievienota neviena drošības atslēga."

#: allauth_ui/templates/mfa/index.html:39
msgid "Add"
msgstr "Pievienot"

#: allauth_ui/templates/mfa/index.html:45
#: allauth_ui/templates/mfa/recovery_codes/generate.html:6
#: allauth_ui/templates/mfa/recovery_codes/index.html:6
msgid "Recovery Codes"
msgstr "Atkopšanas kodi"

#: allauth_ui/templates/mfa/index.html:48
#: allauth_ui/templates/mfa/recovery_codes/index.html:7
#, python-format
msgid ""
"There is %(unused_count)s out of %(total_count)s recovery codes available."
msgid_plural ""
"There are %(unused_count)s out of %(total_count)s recovery codes available."
msgstr[0] "Ir pieejams %(unused_count)s no %(total_count)s atkopšanas koda."
msgstr[1] "Ir pieejami %(unused_count)s no %(total_count)s atkopšanas kodiem."
msgstr[2] "Ir pieejams %(unused_count)s no %(total_count)s atkopšanas kodiem."

#: allauth_ui/templates/mfa/index.html:50
msgid "No recovery codes set up."
msgstr "Atkopšanas kodi nav iestatīti."

#: allauth_ui/templates/mfa/index.html:59
msgid "View"
msgstr "Skatīt"

#: allauth_ui/templates/mfa/index.html:62
msgid "Download"
msgstr "Lejupielādēt"

#: allauth_ui/templates/mfa/index.html:67
#: allauth_ui/templates/mfa/recovery_codes/generate.html:16
msgid "Generate"
msgstr "Ģenerēt"

#: allauth_ui/templates/mfa/reauthenticate.html:6
msgid "Enter an authenticator code:"
msgstr "Ievadiet autentifikatora kodu:"

#: allauth_ui/templates/mfa/recovery_codes/generate.html:7
msgid "You are about to generate a new set of recovery codes for your account."
msgstr "Jūs gatavojaties savam kontam uzģenerēt jaunu atkopšanas kodu komplektu."

#: allauth_ui/templates/mfa/recovery_codes/generate.html:11
msgid "This action will invalidate your existing codes."
msgstr "Šī darbība padarīs jūsu pašreizējos kodus par nederīgiem."

#: allauth_ui/templates/mfa/recovery_codes/generate.html:13
msgid "Are you sure?"
msgstr "Vai esat pārliecināts?"

#: allauth_ui/templates/mfa/recovery_codes/index.html:11
msgid "Unused codes"
msgstr "Neizmantotie kodi"

#: allauth_ui/templates/mfa/recovery_codes/index.html:21
msgid "Download codes"
msgstr "Lejupielādēt kodus"

#: allauth_ui/templates/mfa/recovery_codes/index.html:24
msgid "Generate new codes"
msgstr "Ģenerēt jaunus kodus"

#: allauth_ui/templates/mfa/totp/activate_form.html:7
msgid "Activate Authenticator App"
msgstr "Aktivizēt autentifikatora lietotni"

#: allauth_ui/templates/mfa/totp/activate_form.html:8
msgid ""
"To protect your account with two-factor authentication, scan the QR code "
"below with your authenticator app. Then, input the verification code "
"generated by the app below."
msgstr ""
"Lai aizsargātu savu kontu ar divfaktoru autentifikāciju, noskenējiet zemāk redzamo QR kodu ar savu autentifikācijas lietotni. Pēc tam ievadiet lietotnes uzģenerēto apstiprinājuma kodu zemāk esošajā laukā."

#: allauth_ui/templates/mfa/totp/activate_form.html:22
msgid "Authenticator secret"
msgstr "Autentifikatora slepenā atslēga (secret)"

#: allauth_ui/templates/mfa/totp/activate_form.html:25
msgid ""
"You can store this secret and use it to reinstall your authenticator app at "
"a later time."
msgstr ""
"Jūs varat saglabāt šo slepeno atslēgu, lai vēlāk nepieciešamības gadījumā atjaunotu autentifikācijas lietotni."

#: allauth_ui/templates/mfa/totp/deactivate_form.html:5
msgid "Deactivate Authenticator App"
msgstr "Deaktivizēt autentifikatora lietotni"

#: allauth_ui/templates/mfa/totp/deactivate_form.html:6
msgid ""
"You are about to deactivate authenticator app based authentication. Are you "
"sure?"
msgstr ""
"Jūs gatavojaties deaktivizēt autentifikāciju ar lietotni. Vai esat pārliecināts?"

#: allauth_ui/templates/socialaccount/authentication_error.html:5
msgid "Third-Party Login Failure"
msgstr "Trešās puses pieslēgšanās kļūda"

#: allauth_ui/templates/socialaccount/authentication_error.html:6
msgid ""
"An error occurred while attempting to login via your third-party account."
msgstr ""
"Mēģinot pieslēgties ar trešās puses kontu, radās kļūda."

#: allauth_ui/templates/socialaccount/connections.html:7
msgid "Account Connections"
msgstr "Konta savienojumi"

#: allauth_ui/templates/socialaccount/connections.html:9
msgid ""
"\n"
"        You can sign in to your account using any of the following third-"
"party accounts:\n"
"        "
msgstr ""
"\n"
"        Jūs varat pieslēgties savam kontam, izmantojot kādu no šiem trešo pušu kontiem:\n"
"        "

#: allauth_ui/templates/socialaccount/connections.html:13
msgid "You currently have no third-party accounts connected to this account."
msgstr "Šim kontam šobrīd nav piesaistīts neviens trešās puses konts."

#: allauth_ui/templates/socialaccount/connections.html:39
msgid "Add a Third-Party Account"
msgstr "Pievienot trešās puses kontu"

#: allauth_ui/templates/socialaccount/login.html:7
#, python-format
msgid "Connect %(provider)s"
msgstr "Piesaistīt %(provider)s"

#: allauth_ui/templates/socialaccount/login.html:8
#, python-format
msgid "You are about to connect a new third-party account from %(provider)s."
msgstr "Jūs gatavojaties piesaistīt jaunu trešās puses kontu no %(provider)s."

#: allauth_ui/templates/socialaccount/login.html:10
#, python-format
msgid "Sign In Via %(provider)s"
msgstr "Pieslēgties ar %(provider)s"

#: allauth_ui/templates/socialaccount/login.html:11
#, python-format
msgid "You are about to sign in using a third-party account from %(provider)s."
msgstr "Jūs gatavojaties pieslēgties, izmantojot trešās puses kontu %(provider)s."

#: allauth_ui/templates/socialaccount/signup.html:7
#, python-format
msgid ""
"\n"
"        You are about to use your %(provider_name)s account to login to "
"%(site_name)s.\n"
"        As a final step, please complete the following form:\n"
"    "
msgstr ""
"\n"
"        Jūs gatavojaties izmantot savu %(provider_name)s kontu, lai pieslēgtos vietnei %(site_name)s.\n"
"        Kā pēdējo soli, lūdzu, aizpildiet šo formu:\n"
"    "

#: allauth_ui/templates/socialaccount/snippets/login.html:8
msgid "Or use a third-party"
msgstr "Vai izmantot trešo pusi"

#: allauth_ui/templates/usersessions/usersession_list.html:12
msgid "Sign Out Other Sessions"
msgstr "Izrakstīt pārējās sesijas"

#: allauth_ui/templates/usersessions/usersession_list.html:23
msgid "Started At"
msgstr "Sākta"

#: allauth_ui/templates/usersessions/usersession_list.html:24
msgid "IP Address"
msgstr "IP adrese"

#: allauth_ui/templates/usersessions/usersession_list.html:25
msgid "Browser"
msgstr "Pārlūkprogramma"

#: allauth_ui/templates/usersessions/usersession_list.html:27
msgid "Last seen at"
msgstr "Pēdējo reizi redzēta"

#: allauth_ui/templates/usersessions/usersession_list.html:50
msgid "Current"
msgstr "Pašreizējā"

